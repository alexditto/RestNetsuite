NETSUITE_ACCOUNT_ID=1234567_SB1
NETSUITE_ENVIRONMENT=sandbox

# oauth2 (OAuth 2.0 Client Credentials / M2M) or tba (Token-Based Authentication)
NETSUITE_AUTH_METHOD=tba
NETSUITE_MAX_ATTEMPTS=5

# Required when NETSUITE_AUTH_METHOD=oauth2
NETSUITE_CLIENT_ID=
NETSUITE_CERTIFICATE_ID=
NETSUITE_PRIVATE_KEY_PATH=

# Required when NETSUITE_AUTH_METHOD=tba
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
NETSUITE_HASH_TYPE=sha256
